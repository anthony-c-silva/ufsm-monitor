// Modelo C4 - nivel 1 (contexto). Gerar: dot -Tpdf c4-1-contexto.dot -o c4-1-contexto.pdf
digraph C4_Contexto {
  rankdir=TB;
  graph [fontname="Liberation Sans", nodesep=0.5, ranksep=0.55, pad=0.05, margin=0];
  node  [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=11,
         margin="0.2,0.12", penwidth=1.2];
  edge  [fontname="Liberation Sans", fontsize=9, color="#333333", fontcolor="#222222",
         penwidth=1.1, arrowsize=0.8];

  admin [label=<<b>Administrador</b><br/><font point-size="9">[Pessoa]</font><br/><font point-size="9">Equipe responsável pela rede</font>>,
         fillcolor="#ffe6cc", color="#d79b00"];

  sistema [label=<<b>SONDAR</b><br/><font point-size="9">[Plataforma de monitoramento ativo]</font><br/><font point-size="9">Orquestra medições distribuídas por sondas<br/>e armazena os resultados como séries temporais</font>>,
           fillcolor="#dae8fc", color="#6c8ebf"];

  subgraph cluster_rede {
    label="Rede monitorada"; labeljust="l"; fontname="Liberation Sans"; fontsize=10; fontcolor="#444444";
    style="rounded,dashed"; color="#999999"; margin=14;
    destinos [label=<<b>Destinos de medição</b><br/><font point-size="9">[Sistemas existentes]</font><br/><font point-size="9">Serviços web, servidores DNS<br/>e demais hospedeiros</font>>,
              fillcolor="#f5f5f5", color="#666666"];
  }

  admin   -> sistema  [label=" cadastra planos e consulta resultados (HTTPS)"];
  sistema -> destinos [label=" executa medições ativas", style=dashed];
}
