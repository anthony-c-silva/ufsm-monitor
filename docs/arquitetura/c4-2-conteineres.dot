// Modelo C4 - nivel 2 (conteineres). Gerar: dot -Tpdf c4-2-conteineres.dot -o c4-2-conteineres.pdf
digraph C4_Conteineres {
  rankdir=TB; compound=true; newrank=true;
  graph [fontname="Liberation Sans", nodesep=0.45, ranksep=0.6, pad=0.05, margin=0];
  node  [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=11,
         margin="0.16,0.08", penwidth=1.2, fillcolor="#dae8fc", color="#6c8ebf"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#333333", fontcolor="#222222",
         penwidth=1.1, arrowsize=0.8];

  admin [label=<<b>Administrador</b><br/><font point-size="9">[Pessoa]</font>>, fillcolor="#ffe6cc", color="#d79b00"];

  subgraph cluster_srv {
    label="Servidor central"; labeljust="l"; fontname="Liberation Sans"; fontsize=10; fontcolor="#444444";
    style="rounded,dashed"; color="#999999"; margin=14;
    painel      [label=<<b>Painel web</b><br/><font point-size="9">[React e Vite]</font>>];
    controlador [label=<<b>Controlador</b><br/><font point-size="9">[Python e FastAPI]</font><br/><font point-size="9">Planos, agendador e API</font>>];
    rabbit      [label=<<b>Barramento de mensagens</b><br/><font point-size="9">[RabbitMQ]</font>>];
    ingestao    [label=<<b>Serviço de ingestão</b><br/><font point-size="9">[Python]</font>>];
    banco       [label=<<b>Banco de dados</b><br/><font point-size="9">[PostgreSQL e TimescaleDB]</font>>,
                 shape=cylinder, style=filled, fillcolor="#fff2cc", color="#d6b656"];
  }

  subgraph cluster_sondas {
    label="Sondas distribuídas pela rede"; labeljust="l"; fontname="Liberation Sans"; fontsize=10; fontcolor="#444444";
    style="rounded,dashed"; color="#82b366"; margin=14;
    sondaA [label=<<b>Sonda A</b><br/><font point-size="9">[Agente em Go]</font>>, fillcolor="#d5e8d4", color="#82b366"];
    sondaB [label=<<b>Sonda B</b><br/><font point-size="9">[Agente em Go]</font>>, fillcolor="#d5e8d4", color="#82b366"];
  }

  destinos [label=<<b>Destinos externos</b><br/><font point-size="9">[Sistemas existentes]</font>>, fillcolor="#f5f5f5", color="#666666"];

  { rank=same; painel; controlador; }
  { rank=same; rabbit; ingestao; banco; }
  { rank=same; sondaA; sondaB; }

  admin -> painel             [label=" HTTPS"];
  painel -> controlador       [label="API (HTTPS)"];
  controlador -> rabbit       [label=" tarefas"];
  controlador -> banco        [label=" planos (SQL)"];
  rabbit -> ingestao          [label="resultados"];
  ingestao -> banco           [label="séries (SQL)"];
  rabbit -> sondaA            [lhead=cluster_sondas, label=" tarefas e resultados (AMQP)", dir=both];

  edge [style=dashed, color="#2d7a3e", fontcolor="#2d7a3e"];
  sondaA -> sondaB            [label="medição mútua", dir=both];
  sondaB -> destinos          [ltail=cluster_sondas, label=" medição"];
}
