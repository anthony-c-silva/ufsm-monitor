// Modelo C4 - nivel 3 (componentes do agente). Gerar: dot -Tpdf c4-3-componentes-agente.dot -o c4-3-componentes-agente.pdf
digraph C4_Componentes_Agente {
  rankdir=TB; compound=true; newrank=true;
  graph [fontname="Liberation Sans", nodesep=0.4, ranksep=0.5, pad=0.05, margin=0];
  node  [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=11,
         margin="0.14,0.07", penwidth=1.2, fillcolor="#d5e8d4", color="#82b366"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#333333", fontcolor="#222222",
         penwidth=1.1, arrowsize=0.8];

  rabbit [label=<<b>Barramento de mensagens</b><br/><font point-size="9">[RabbitMQ]</font>>, fillcolor="#dae8fc", color="#6c8ebf"];

  subgraph cluster_agente {
    label="Agente executado na sonda [Go]"; labeljust="r"; fontname="Liberation Sans"; fontsize=10; fontcolor="#444444";
    style="rounded,dashed"; color="#82b366"; margin=14;

    cliente  [label=<<b>Cliente do barramento</b><br/><font point-size="9">Recebe tarefas e publica resultados</font>>];
    executor [label=<<b>Executor</b><br/><font point-size="9">Seleciona a medição pelo tipo de teste</font>>];
    medicao  [label=<<b>Módulos de medição</b><br/><font point-size="9">fping, iperf3, dig, mtr e cliente HTTP</font>>];
    fila     [label=<<b>Fila local</b><br/><font point-size="9">[SQLite]</font>>, shape=cylinder, style=filled, fillcolor="#fff2cc", color="#d6b656"];
    saude    [label=<<b>Servidor de saúde</b><br/><font point-size="9">Estado do agente (HTTP)</font>>];
    destino  [label=<<b>Serviços de destino</b><br/><font point-size="9">Servidores iperf3 e DNS</font>>];
  }

  outros [label=<<b>Outras sondas e destinos externos</b>>, fillcolor="#f5f5f5", color="#666666"];

  { rank=same; executor; fila; }
  { rank=same; medicao; saude; destino; }

  rabbit  -> cliente  [label=" tarefas e resultados (AMQP)", dir=both];
  cliente -> executor [label=" tarefa"];
  executor -> medicao [label=" executa"];
  executor -> fila    [label="grava resultado"];
  fila -> cliente     [label="resultados\npendentes", constraint=false];

  edge [style=dashed, color="#2d7a3e", fontcolor="#2d7a3e"];
  medicao -> outros   [label=" mede"];
  outros  -> destino  [label=" medem"];
}
